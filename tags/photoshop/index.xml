	height=&#34;989&#34;
	srcset=&#34;https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E5%AD%97%E4%BD%93%E5%88%B6%E4%BD%9C1_hu_b569d70bd421cb96.png 480w, https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E5%AD%97%E4%BD%93%E5%88%B6%E4%BD%9C1_hu_aa73b49bbb28566a.png 1024w&#34;
