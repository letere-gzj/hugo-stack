	loading=&#34;lazy&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;137&#34;
		data-flex-basis=&#34;331px&#34;
	
&gt;
&lt;img src=&#34;https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9.png&#34;
	width=&#34;2040&#34;
	height=&#34;1204&#34;
	srcset=&#34;https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9_hu2151855884137967969.png 480w, https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9_hu12466394722325979308.png 1024w&#34;
