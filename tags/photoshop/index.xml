&lt;img src=&#34;https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9.png&#34;
	width=&#34;2040&#34;
	height=&#34;1204&#34;
	srcset=&#34;https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9_hu_e0b6186ba5754bda.png 480w, https://letere-gzj.github.io/hugo-stack/p/ps/striped-perforated-font/make/%E6%96%9C%E7%BA%B9%E5%88%B6%E4%BD%9C9_hu_2a1446faf0cb0eea.png 1024w&#34;
